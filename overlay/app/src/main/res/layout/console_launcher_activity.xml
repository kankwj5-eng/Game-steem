<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/console_background"
    android:orientation="horizontal">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="34dp"
        android:paddingTop="26dp"
        android:paddingEnd="30dp"
        android:paddingBottom="26dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.17"
                    android:text="DROIDDECK"
                    android:textColor="@color/console_text"
                    android:textSize="26sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="STEAM PARA ANDROID"
                    android:textColor="@color/console_muted"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/TVMode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AUTO"
                android:textColor="@color/console_accent"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <Space
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Steam."
            android:textColor="@color/console_text"
            android:textSize="52sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/TVSteamState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Preparando todo automáticamente…"
            android:textColor="@color/console_muted"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/TVDeviceInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Detectando hardware…"
            android:textColor="@color/console_muted"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/TVCurrentStage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Preparando sistema"
            android:textColor="@color/console_text"
            android:textSize="18sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="bottom"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/TVCurrentDetail"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Iniciando…"
                android:textColor="@color/console_muted"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/TVCurrentPercent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0%"
                android:textColor="@color/console_text"
                android:textSize="30sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/PBCurrent"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:layout_marginTop="8dp"
            android:max="100"
            android:progress="0" />

        <Button
            android:id="@+id/BTStartSteam"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/console_button"
            android:text="PREPARANDO…"
            android:textColor="@color/console_text"
            android:textSize="14sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">
            <Button
                android:id="@+id/BTControls"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/console_button_secondary"
                android:text="CONTROLES"
                android:textColor="@color/console_text"
                android:textSize="11sp" />
            <Space
                android:layout_width="10dp"
                android:layout_height="1dp" />
            <Button
                android:id="@+id/BTDiagnostics"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/console_button_secondary"
                android:text="DIAGNÓSTICO"
                android:textColor="@color/console_text"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:background="#2BFFFFFF" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="#66040812"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingTop="26dp"
        android:paddingEnd="28dp"
        android:paddingBottom="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ACTIVIDAD EN VIVO"
            android:textColor="@color/console_text"
            android:textSize="18sp"
            android:textStyle="bold" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="14dp"
            android:layout_weight="0.92"
            android:fillViewport="true">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView android:id="@+id/StepPermissionsStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/console_muted" android:textSize="12sp" />
                <ProgressBar android:id="@+id/StepPermissionsProgress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="3dp" android:max="100" />
                <TextView android:id="@+id/StepSystemStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="9dp" android:textColor="@color/console_muted" android:textSize="12sp" />
                <ProgressBar android:id="@+id/StepSystemProgress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="3dp" android:max="100" />
                <TextView android:id="@+id/StepGpuStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="9dp" android:textColor="@color/console_muted" android:textSize="12sp" />
                <ProgressBar android:id="@+id/StepGpuProgress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="3dp" android:max="100" />
                <TextView android:id="@+id/StepContainerStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="9dp" android:textColor="@color/console_muted" android:textSize="12sp" />
                <ProgressBar android:id="@+id/StepContainerProgress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="3dp" android:max="100" />
                <TextView android:id="@+id/StepSteamStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="9dp" android:textColor="@color/console_muted" android:textSize="12sp" />
                <ProgressBar android:id="@+id/StepSteamProgress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="3dp" android:max="100" />
                <TextView android:id="@+id/StepLaunchStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="9dp" android:textColor="@color/console_muted" android:textSize="12sp" />
                <ProgressBar android:id="@+id/StepLaunchProgress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="3dp" android:max="100" />
            </LinearLayout>
        </ScrollView>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp"
            android:background="#24FFFFFF" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="CONSOLA REAL"
                android:textColor="@color/console_text"
                android:textSize="13sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/TVLogPath"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="2"
                android:ellipsize="middle"
                android:gravity="end"
                android:maxLines="1"
                android:textColor="@color/console_muted"
                android:textSize="9sp" />
        </LinearLayout>

        <ScrollView
            android:id="@+id/SVConsoleLog"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_weight="1.08"
            android:background="#52000000"
            android:padding="10dp">
            <TextView
                android:id="@+id/TVConsoleLog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="Esperando actividad…"
                android:textColor="#CBD3E9"
                android:textIsSelectable="true"
                android:textSize="10sp" />
        </ScrollView>

        <LinearLayout
            android:id="@+id/ErrorActions"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="10dp"
            android:orientation="horizontal"
            android:visibility="gone">
            <Button
                android:id="@+id/BTRetry"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/console_button_secondary"
                android:text="REINTENTAR"
                android:textColor="@color/console_text" />
            <Space android:layout_width="10dp" android:layout_height="1dp" />
            <Button
                android:id="@+id/BTCloseDiagnostics"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/console_button_secondary"
                android:text="OCULTAR ERROR"
                android:textColor="@color/console_text" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
